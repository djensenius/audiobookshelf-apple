          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Elementet mangler og må bli korrigert på tjeneren. Vanligvis blir et element markert som manglende hvis filens lokasjon ikke er tilgjengelig."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Item is niet beschikbaar en moet opgelost worden op de server. Meestal is een item gemarkeerd als missend in verband met niet bereikbare bestandspaden."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Brakuje elementu i należy go naprawić na serwerze. Zazwyczaj element jest oznaczany jako brakujący, ponieważ ścieżki do plików nie są dostępne."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O item está ausente e precisa ser corrigido no servidor. Normalmente, um item é marcado como ausente quando não é possível acessar o caminho para o arquivo."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Elementul lipsește și trebuie reparat pe server. De obicei este marcat ca lipsă deoarece căile fișierelor nu sunt accesibile."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Элемент отсутствует и должен быть исправлен на сервере. Обычно элемент помечается как отсутствующий, поскольку пути к файлам недоступны."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Položka neexistuje, chybu je nutné opraviť na serveri. Najčastejšou príčinou označenia položky za chýbajúcu je nedostupnosť jej umiestnenia."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Element manjka in ga je treba popraviti na strežniku. Običajno je element označen kot manjkajoči, ker poti datoteke niso dostopne."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Objektet saknas och måste åtgärdas på servern. Det beror oftast på att sökvägen till objektet inte kan nås."
          }
        },
        "ta" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "உருப்படி காணவில்லை மற்றும் சர்வரில் சரி செய்யப்பட வேண்டும். கோப்பு பாதைகள் அணுக முடியாததால் பொதுவாக ஒரு உருப்படி விடுபட்டதாகக் குறிக்கப்படுகிறது."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Öğe eksik ve sunucuda düzeltilmesi gerekiyor. Genellikle bir öğe, dosya yollarına erişilemediği için eksik olarak işaretlenir."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Елемент відсутній і його потрібно виправити на сервері. Зазвичай елемент позначається як відсутній, оскільки шляхи до файлів недоступні."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Item is missing and must be fixed on the server. Typically an item is marked as missing because the file paths are not accessible."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "项目丢失，必须在服务器上修复。项目被标记为丢失通常是因为文件路径无法访问。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "項目遺失且必須在伺服器端修正。項目通常會因無法存取檔案路徑而被標記為遺失。"
          }
        }
      }
