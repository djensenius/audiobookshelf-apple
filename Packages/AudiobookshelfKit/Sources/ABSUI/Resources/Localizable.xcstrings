    "LabelDisableVibrateOnResetHelp" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "عند إعادة ضبط مؤقت النوم، سيهتز جهازك. فعّل هذا الإعداد لعدم الاهتزاز عند إعادة ضبط مؤقت النوم."
          }
        },
        "be" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Калі таймер сну скідваецца, ваша прылада будзе вібраваць. Уключыце гэтую наладу, каб адключыць вібрацыю пры скідзе таймера сну."
          }
        },
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Когато таймерът за изключване бъде рестартиран, устройството ви ще вибрира. Активирайте тази настройка, за да не вибрира при рестартиране на таймера за изключване."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "স্লিপ টাইমার রিসেট হয়ে গেলে আপনার ডিভাইস কম্পিত হবে। স্লিপ টাইমার রিসেট করার সময় কম্পন না করতে এই সেটিংটি সক্ষম করুন।"
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Quan el temporitzador d'apagat es reinicia, el dispositiu vibra. Activa aquesta opció perquè no vibri quan es reiniciï el temporitzador."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Když je časovač spánku resetován, zařízení zavibruje. Tuto možnost povolte, pokud nechcete, aby zařízení vibrace provádělo při resetování časovače spánku."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Når sleep-timeren nulstilles, vil din enhed vibrere. Aktiver denne indstilling for ikke at vibrere, når sleep-timeren nulstilles."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wenn der Sleep-Timer zurückgesetzt wird, vibriert dein Gerät. Aktiviere diese Einstellung, um nicht zu vibrieren, wenn der Sleep-Timer zurückgesetzt wird."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Όταν γίνει επαναφορά του χρονοδιακόπτη ύπνου, η συσκευή σας θα δονηθεί. Ενεργοποιήστε αυτήν τη ρύθμιση για να μην δονείται κατά την επαναφορά του χρονοδιακόπτη ύπνου."
          }
        },
        "en" : {
