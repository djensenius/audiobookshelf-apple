    "LabelDisableAudioFadeOutHelp" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "سيبدأ مستوى الصوت بالانخفاض عندما يتبقى أقل من دقيقة واحدة على مؤقت النوم. فعّل هذا الإعداد لعدم التلاشي."
          }
        },
        "be" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Гучнасць гуку пачне змяншацца, калі на таймеры сну застанецца менш за 1 хвіліну. Уключыце гэтую наладу, каб пазбегнуць змяншэння гучнасці."
          }
        },
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Силата на звука ще започне да намалява, когато остава по-малко от 1 минута до края на таймера за изключване. Активирайте тази настройка, за да не се извършва затихване."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "স্লিপ টাইমারে ১ মিনিটেরও কম সময় বাকি থাকলে অডিওর ভলিউম কমতে শুরু করবে। বিবর্ণ না হওয়ার জন্য এই সেটিংটি সক্ষম করুন।"
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El volum de l'audio començara a reduïr-se quan quedi menys d'1 minut del temporitzador d'anar a dormir. Habilita aquest ajustament per a no reduïr el volum."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hlasitost zvuku začne klesat, pokud zbývá méně než 1 minuta do vypršení časovače spánku. Tuto možnost povolte, pokud nechcete postupné snižování hlasitosti."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lydstyrken begynder at falde, når der er mindre end 1 minut tilbage på sleep-timeren. Aktiver denne indstilling for ikke at fade ud."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Audiolautstärke wird verringert, wenn weniger als 1 Minute für den Sleep-Timer verbleibt. Aktiviere diese Einstellung, um nicht abzuklingen."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Η ένταση του ήχου θα αρχίσει να μειώνεται όταν απομένει λιγότερο από 1 λεπτό στον χρονοδιακόπτη ύπνου. Ενεργοποιήστε αυτή τη ρύθμιση για να μην γίνεται σταδιακή μείωση."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Audio volume will start decreasing when there is less than 1 minute remaining on the sleep timer. Enable this setting to not fade out."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El volumen de audio comenzará a disminuir cuando quede menos de 1 minuto en el temporizador de dormida. Habilite este ajuste para que no se desvanezca."
          }
        },
        "et" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Audio volume will start decreasing when there is less than 1 minute remaining on the sleep timer. Enable this setting to not fade out."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Audio volume will start decreasing when there is less than 1 minute remaining on the sleep timer. Enable this setting to not fade out."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Äänenvoimakkuus alkaa laskea kun uniajastimessa on jäljellä alle minuutti. Laita tämä asetus pois päältä estääksesi sen."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le volume audio diminuera lorsqu’il restera moins d’une minute avant la mise en veille. Activez ce paramètre pour que le volume ne diminue pas."
          }
        },
        "gu" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Audio volume will start decreasing when there is less than 1 minute remaining on the sleep timer. Enable this setting to not fade out."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "עוצמת השמע תתחיל לרדת כאשר נותרה פחות מדקה אחת בטיימר השינה. הפעל הגדרה זו כדי לא לדעוך."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Audio volume will start decreasing when there is less than 1 minute remaining on the sleep timer. Enable this setting to not fade out."
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zvuk će se početi stišavati kada preostane manje od minute na timeru za spavanje. Ako ne želite stišavati zvuk, uključite ovu mogućnost."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A hangerő csökkenni kezd az alvásidőzítő utolsó percében. Kapcsold be ezt a beállítást a halkítás kikapcsolásához."
          }
        },
        "is" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Audio volume will start decreasing when there is less than 1 minute remaining on the sleep timer. Enable this setting to not fade out."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il volume dell'audio inizierà a diminuire quando rimane meno di 1 minuto sul timer di spegnimento. Abilita questa impostazione per non diminuirlo."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "スリープタイマーの残り時間が1分を切ると、音量が徐々に小さくなります。フェードアウトしないようにするには、この設定を有効にしてください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "슬립 타이머가 1분 미만으로 남았을 때 오디오 볼륨이 감소하기 시작합니다. 이 설정을 활성화하면 볼륨이 점점 작아지지 않습니다."
          }
        },
        "lt" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Audio volume will start decreasing when there is less than 1 minute remaining on the sleep timer. Enable this setting to not fade out."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lydstyrke vil minkes når det er mindre enn ett minutt igjen på søvntidsuret. Aktiver denne innstillingen for å ikke ha uttoning."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Het audiovolume zal afnemen wanneer er minder dan 1 minuut resteert op de slaaptimer. Schakel deze instelling in om niet uit te faden."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Głośność dźwięku zacznie się zmniejszać, gdy na wyłączniku czasowym pozostanie mniej niż 1 minuta. Włącz to ustawienie, jeśli nie chcesz korzystać z zanikania dźwięku."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O volume do áudio diminuirá progressivamente quando houver menos que 1 minuto no seu timer. Ative essa configuração para não diminuir o volume."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Volumul audio va scădea treptat când mai rămâne sub 1 minut din timerul de somn. Activează această opțiune pentru a dezactiva estomparea."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Громкость звука начнет уменьшаться, когда на таймере сна останется менее 1 минуты. Включите этот параметр, чтобы громкость не изменялась."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hlasitosť prehrávania sa automaticky začne znižovať, ak zostáva menej ako 1 minúta na časovači spánku. Povolením tejto voľby sa fade out efekt vypne."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Glasnost zvoka se bo začela zmanjševati, ko je na časovniku izklopa manj kot 1 minuta. Omogočite to nastavitev, da se ne zmanjšuje."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ljudvolymen börjar sänkas när mindre än en minut återstår av insomningstimern. Aktivera alternativet för att förhindra uttoningen."
          }
        },
        "ta" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ச்லீப் டைமரில் 1 நிமிடத்திற்கும் குறைவான நேரம் இருக்கும் போது ஆடியோ வால்யூம் குறையத் தொடங்கும். மங்காமல் இருக்க இந்த அமைப்பை இயக்கவும்."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Uyku zamanlayıcısında 1 dakikadan az kaldığında ses seviyesi azalmaya başlar. Bu ayarı etkinleştirerek sesin kısılmasını engelleyebilirsiniz."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Гучність звуку почне зменшуватися, коли на таймері вимкнення лишиться 1 хвилина. Увімкніть це налаштування, аби прибрати затихання."
