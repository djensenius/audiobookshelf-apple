    "MessageProgressSyncFailed" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "فشلت آخر محاولة لإرسال تقدم استماعك إلى الخادم. ستستمر محاولات مزامنة التقدم كل 15 ثانية إلى دقيقة واحدة أثناء تشغيل الوسائط."
          }
        },
        "be" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Апошняя спроба адправіць ваш прагрэс праслухоўвання на сервер не ўдалася. Спробы сінхранізаваць прагрэс будуць працягвацца кожныя 15 секунд на працягу 1 хвіліны падчас прайгравання медыяфайла."
          }
        },
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Последният опит за докладване на напредъка ви в слушането към сървъра не успя. Заявките за синхронизиране на напредъка ще продължат да се опитват на всеки 15 секунди до 1 минута, докато медията се възпроизвежда."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "সার্ভারে আপনার শোনার অগ্রগতি জানানোর সর্বশেষ প্রচেষ্টা ব্যর্থ হয়েছে। মিডিয়া চলাকালীন প্রতি ১৫ সেকেন্ড থেকে ১ মিনিট পরপর অগ্রগতি সিঙ্ক করার চেষ্টা চলতে থাকবে।"
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "The most recent attempt to report your listening progress to the server has failed. Progress sync requests will continue to be attempted every 15 seconds to 1 minute while media is playing."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Poslední pokus o nahlášení průběhu poslechu na server se nezdařil. Během přehrávání médií se budou požadavky na synchronizaci pokroku nadále pokoušet každých 15 až 60 sekund."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Det seneste forsøg på indrapportering af dit lyttefremskridt til serveren er fejlet. Fremskridtssynkroniseringsforespørgsler vil forsøges mellem hvert 15 sekund og 1 minut mens medie afspilles."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Der letzte Versuch den aktuellen Hörfortschritt an den Server zu melden ist fehlgeschlagen. Die Anfragen den Fortschritt zu synchronisieren wird alle 15 Sekunden bis 1 Minute versucht, während Medien abgespielt werden."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "The most recent attempt to report your listening progress to the server has failed. Progress sync requests will continue to be attempted every 15 seconds to 1 minute while media is playing."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The most recent attempt to report your listening progress to the server has failed. Progress sync requests will continue to be attempted every 15 seconds to 1 minute while media is playing."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El último intento de informar al servidor sobre el progreso de la escucha ha fallado. Las solicitudes de sincronización de progreso seguirán intentándose cada 15 segundos a 1 minuto mientras se reproduce el contenido multimedia."
          }
        },
        "et" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "The most recent attempt to report your listening progress to the server has failed. Progress sync requests will continue to be attempted every 15 seconds to 1 minute while media is playing."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "The most recent attempt to report your listening progress to the server has failed. Progress sync requests will continue to be attempted every 15 seconds to 1 minute while media is playing."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Viimeisin yritys raportoida kuuntelun edistymisestä palvelimelle epäonnistui. Edistymisen synkronointipyyntöjä yritetään edelleen 15 sekunnin tai minuutin välein median toiston aikana."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La dernière tentative de rapporter vos progrès d'écoute sur le serveur a échoué. Les demandes de synchronisation continueront d'être tentées toutes les 15 secondes à 1 minute pendant que les médias sont lus."
          }
        },
        "gu" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "The most recent attempt to report your listening progress to the server has failed. Progress sync requests will continue to be attempted every 15 seconds to 1 minute while media is playing."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "הניסיון האחרון לדווח על התקדמות ההאזנה שלך לשרת נכשל. בקשות סנכרון התקדמות ימשיכו להתבצע כל 15 שניות עד דקה בזמן שהמדיה מופעלת."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "The most recent attempt to report your listening progress to the server has failed. Progress sync requests will continue to be attempted every 15 seconds to 1 minute while media is playing."
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zadnji pokušaj slanja napretka slušanja poslužitelju nije uspio. Nastavit ćemo s pokušajima slanja napretka svakih 15 do 60 sekundi dok god traje izvođenje medijske datoteke."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A legutóbbi kísérlet, hogy jelentse a hallgatás folyamatát a szervernek, meghiúsult. A folyamatban lévő szinkronizálási kérelmek továbbra is 15 másodperctől 1 percig terjednek, miközben a média lejátssza."
          }
        },
        "is" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "The most recent attempt to report your listening progress to the server has failed. Progress sync requests will continue to be attempted every 15 seconds to 1 minute while media is playing."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il tentativo più recente di segnalare i tuoi progressi di ascolto al server è fallito. Le richieste di sincronizzazione dei progressi continueranno a essere tentate ogni 15 secondi - 1 minuto mentre il contenuto multimediale è in riproduzione."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "The most recent attempt to report your listening progress to the server has failed. Progress sync requests will continue to be attempted every 15 seconds to 1 minute while media is playing."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "서버에 청취 진행 상황을 보고하려는 최근 시도가 실패했습니다. 미디어 재생 중에는 15초에서 1분 간격으로 진행 상황 동기화 요청이 계속 시도됩니다."
          }
        },
        "lt" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "The most recent attempt to report your listening progress to the server has failed. Progress sync requests will continue to be attempted every 15 seconds to 1 minute while media is playing."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Det siste forsøket på å rapportere lyttefremdriften til tjeneren mislyktes. Forsøk på å synkronisere fremdriften vil fortsette hvert 15. sekund til hvert minutt så lenge mediet spilles av."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "De meest recente poging om je luistervoortgang aan de server te rapporteren is mislukt. Verzoeken om voortgangssynchronisatie worden nog steeds elke 15 seconden tot 1 minuut uitgevoerd terwijl de media wordt afgespeeld."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ostatnia próba zgłoszenia postępu słuchania do serwera nie powiodła się. Żądania synchronizacji postępu będą nadal podejmowane co 15 sekund do 1 minuty podczas odtwarzania multimediów."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A tentativa mais recente de informar o seu progresso de escuta para o servidor falhou. Os pedidos de sincronia de progresso continuarão a ser tentados a cada 15 segundo a 1 minuto enquanto a mídia estiver sendo reproduzida."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ultima încercare de a raporta progresul de ascultare către server a eșuat. Cererile de sincronizare vor continua la fiecare 15 secunde – 1 minut cât timp rulează redarea."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Последняя попытка сообщить о вашем прогрессе прослушивания на сервер не удалась. Запросы на синхронизацию прогресса будут продолжаться каждые 15 секунд в течении 1 минуты во время воспроизведения медиа."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Posledný pokus o odoslanie vášho stavu počúvania na server zlyhal. Aplikácia sa pokúsi odoslať váš stav každých 15 sekúnd až 1 minúty počas prehrávania média."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zadnji poskus poročanja strežniku o napredku poslušanja ni uspel. Zahteve za sinhronizacijo napredka se bodo med predvajanjem predstavnosti še naprej poskušale izvajati vsakih 15 sekund do 1 minuto."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Det senaste försöket att skicka uppspelningspositionen till servern misslyckades. Appen fortsätter att försöka synkronisera positionen med 15 sekunders till en minuts mellanrum medan mediet spelas upp."
          }
        },
        "ta" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "நீங்கள் கேட்கும் முன்னேற்றத்தை சர்வரில் தெரிவிக்கும் மிகச் அண்மைக் கால முயற்சி தோல்வியடைந்தது. மீடியா இயங்கும் போது முன்னேற்ற ஒத்திசைவு கோரிக்கைகள் ஒவ்வொரு 15 வினாடிகள் முதல் 1 மணித்துளி வரை தொடர்ந்து முயற்சிக்கும்."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dinleme ilerlemenizi sunucuya bildirme denemesi başarısız oldu. Medya oynatılırken ilerleme eşitleme istekleri her 15 saniyede bir ile 1 dakika arasında denenmeye devam edecektir."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Остання спроба повідомити про прогрес прослуховування на сервер не вдалася. Під час відтворення мультимедійних файлів кожні 15 секунд – 1 хвилину надсилатимуться запити на синхронізацію."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "The most recent attempt to report your listening progress to the server has failed. Progress sync requests will continue to be attempted every 15 seconds to 1 minute while media is playing."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "向服务器报告收听进度的最新尝试失败。播放媒体时，将继续每 15 秒至 1 分钟尝试一次进度同步请求。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "最近一次向伺服器回報您的收聽進度失敗。播放媒體時，系統將繼續嘗試每 15 秒至 1 分鐘發送一次進度同步請求。"
          }
        }
      }
    },
