          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kohde puuttuu ja se on korjattava palvelimella. Tyypillisesti kohde merkitään puuttuvaksi, koska tiedostopolut eivät ole käytettävissä."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L'élément est manquant et doit être corrigé sur le serveur. Typiquement un objet est marqué comme manquant parce que le fichier n'est pas accessible."
          }
        },
        "gu" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Item is missing and must be fixed on the server. Typically an item is marked as missing because the file paths are not accessible."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "הפריט חסר ונדרש תיקונו בשרת. בדרך כלל פריט מסומן כחסר כי נתיבי הקובץ הקיימים לא נגישים."
