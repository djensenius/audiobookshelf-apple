    "LabelDisableShakeToResetHelp" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "سيؤدي هزّ جهازك أثناء تشغيل المؤقت أو خلال دقيقتين من انتهاءه إلى إعادة ضبط مؤقت النوم. فعّل هذا الإعداد لتعطيل الرج لإعادة الضبط."
          }
        },
        "be" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Калі патрэсці прыладу падчас працы таймера АБО на працягу 2 хвілін пасля заканчэння таймера, таймер сну скідваецца. Уключыце гэтую наладу, каб адключыць скід устрэсваннем."
          }
        },
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Разклащането на устройството ви докато таймерът работи ИЛИ в рамките на 2 минути преди изтичането му ще рестартира таймера за изключване. Активирайте тази настройка, за да деактивирате рестартирането чрез разклащане."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "টাইমার চলার সময় বা টাইমারের মেয়াদ শেষ হওয়ার ২ মিনিটের মধ্যে আপনার ডিভাইস ঝাঁকালে ঘুমের টাইমার রিসেট করবে। ঝাঁকালে রিসেট করা অক্ষম করতে এই সেটিংটি সক্ষম করুন।"
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Si sacseges el teu dispositiu quan el temporitzador és actiu o durant els 2 minuts després que hagi expirat, el temporitzador es reinicia. Activa aquesta opció per evitar-ho."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Když je časovač spánku spuštěn nebo zbýva 2 minuty do jeho vypršení, zatřesení zařízením se resetuje časovač spánku. Povolte toto nastavení, pokud chcete resetování otřesem zakázat."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hvis du ryster din enhed, mens timeren kører ELLER inden for 2 minutter før, at timeren er udløbet, nulstilles sleeptimeren. Aktiver denne indstilling for at deaktivere \"rystelse for at nulstille\"."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wenn du dein Gerät schüttelst, während der Timer läuft ODER innerhalb von 2 Minuten nach Ablauf des Timers, wird der Sleep-Timer zurückgesetzt. Aktiviere diese Einstellung, um das Schütteln zum Zurücksetzen zu deaktivieren."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Αν κουνήσετε τη συσκευή σας ενώ λειτουργεί ο χρονοδιακόπτης Ή εντός 2 λεπτών από τη λήξη του χρονοδιακόπτη, θα επαναφέρετε τον χρονοδιακόπτη ύπνου. Ενεργοποιήστε αυτήν τη ρύθμιση για να απενεργοποιήσετε το κούνημα για επαναφορά."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Shaking your device while the timer is running OR within 2 minutes of the timer expiring will reset the sleep timer. Enable this setting to disable shake to reset."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Si agitas el dispositivo mientras el temporizador está en marcha o en los 2 minutos siguientes a la caducidad del temporizador, éste se reiniciará. Habilita estos ajustes para desactivar el restablecimiento al agitar."
          }
        },
        "et" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Shaking your device while the timer is running OR within 2 minutes of the timer expiring will reset the sleep timer. Enable this setting to disable shake to reset."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Shaking your device while the timer is running OR within 2 minutes of the timer expiring will reset the sleep timer. Enable this setting to disable shake to reset."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ravistamalla laitettasi uniajastimen kuluessa tai enintään kaksi minuuttia sen loppumisen jälkeen uudistaa ajastimen."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Si vous secouez votre appareil pendant que la minuterie est en cours OU dans les 2 minutes qui suivent son expiration, alors la minuterie de sommeil sera réinitialisée. Activez ce paramètre pour désactiver la fonction « Secouer pour réinitialiser »."
          }
        },
        "gu" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Shaking your device while the timer is running OR within 2 minutes of the timer expiring will reset the sleep timer. Enable this setting to disable shake to reset."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ניעור המכשיר בזמן שהטיימר פועל או תוך 2 דקות ממועד סופו יאפס את טיימר השינה. הפעל הגדרה זו כדי להשבית את הניעור לצורך איפוס."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Shaking your device while the timer is running OR within 2 minutes of the timer expiring will reset the sleep timer. Enable this setting to disable shake to reset."
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ukoliko zatresete svoj uređaj tijekom trajanja timera ILI unutar dvije minute od isteka timera, timer će ponovno početi odbrojavati. Uključite ovu mogućnost ako želite onemogućiti tu opciju."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ha az időzítő futása alatt vagy az időzítő lejárta előtti 2 percben megrázza az eszközt, az alvásidőzítő visszaáll. Engedélyezze ezt a beállítást a rázásra történő visszaállítás letiltásához."
          }
        },
        "is" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Shaking your device while the timer is running OR within 2 minutes of the timer expiring will reset the sleep timer. Enable this setting to disable shake to reset."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Scuotendo il dispositivo mentre il timer è in esecuzione O entro 2 minuti dalla scadenza del timer si ripristinerà il timer di spegnimento. Abilita questa impostazione per disabilitare lo scuotimento per ripristinare."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "タイマー作動中、またはタイマー終了後2分以内に端末を振ると、スリープタイマーがリセットされます。この設定を有効にすると、振ってリセットする機能を無効にできます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "타이머가 작동하는 동안 또는 타이머가 만료되기 2분 전에 기기를 흔들면 슬립 타이머가 재설정됩니다. 이 설정을 활성화하면 흔들어서 재설정하는 기능을 비활성화할 수 있습니다."
          }
        },
        "lt" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Shaking your device while the timer is running OR within 2 minutes of the timer expiring will reset the sleep timer. Enable this setting to disable shake to reset."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Rister du enheten mens tidsuret kjører, eller opptil to minutter etter utløp av tidsuret, tilbakestillers søvntidsuret. Aktiver denne innstillinger for å skru av risting for å tilbakestille."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Schudden van uw apparaat terwijl de timer loopt OF binnen 2 minuten nadat de timer afloopt, zal de slaaptimer resetten. Schakel deze instelling in om schudden om te resetten uit te schakelen."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Potrząsanie urządzeniem podczas pracy minutnika LUB w ciągu 2 minut od jego wygaśnięcia spowoduje zresetowanie wyłącznika czasowego. Włącz to ustawienie, aby wyłączyć potrząsanie w celu zresetowania."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sacudir o seu dispositivo quando o timer estiver ativo OU em até 2 minutos após o seu fim resetará o seu timer. Ative essa configuração para desabilitar o sacudir para resetar."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Scuturarea dispozitivului în timp ce rulează timerul sau în 2 minute după expirarea lui va reseta timerul de somn. Activează această opțiune pentru a dezactiva resetarea prin scuturare."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Встряхивание устройства во время работы таймера ИЛИ в течение 2 минут после истечения таймера приведет к сбросу таймера сна. Включите этот параметр, чтобы отключить встряхивание для сброса."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Potrasením vášho zariadenia v prípade, ak časovač beží ALEBO na ňom zostáva menej ako 2 minúty, dôjde k rešttartovaniu časovača. Povolením tejto voľby reštart zatrasením vypnete."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Če stresete napravo, medtem ko časovnik teče ALI v 2 minutah po izteku časovnika, se ponastavi časovnik spanja. Omogočite to nastavitev, da onemogočite tresenje za ponastavitev."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Om du skakar enheten medan timern är aktiv, eller inom två minuter efter att den har löpt ut, återställs insomningstimern. Aktivera alternativet för att inaktivera funktionen."
          }
        },
        "ta" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "நேரங்குறிகருவி இயங்கும் போது உங்கள் சாதனத்தை அசைப்பது அல்லது நேரங்குறிகருவி காலாவதியான 2 நிமிடங்களுக்குள் ச்லீப் டைமரை மீட்டமைக்கும். மீட்டமைக்க சேக்கை முடக்க இந்த அமைப்பை இயக்கவும்."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zamanlayıcı çalışırken VEYA bitmesine 2 dakikadan az kala cihazınızı sallamak uyku zamanlayıcısını sıfırlar. Bu özelliği devre dışı bırakmak için bu ayarı etkinleştirin."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Якщо потрясти пристроєм під час роботи таймера або протягом 2 хвилин після його закінчення, то таймер перезапуститься. Увімкніть це налаштування, аби вимкнути перезапуск струшуванням."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Rung thiết bị của bạn trong khi bộ đếm đang chạy HOẶC trong vòng 2 phút sau khi bộ đếm kết thúc sẽ đặt lại bộ đếm thời gian ngủ. Bật cài đặt này để tắt chế độ rung để đặt lại."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "在计时器运行时摇晃设备，或者在计时器到期后 2 分钟内摇晃设备将重置睡眠计时器。启用此设置禁用摇晃设备重置。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "在定時器運行時搖晃設備，或者字啊定時器到期後兩分鐘內搖晃設備將重置睡眠定時器，啟用此設置將關閉該功能。"
          }
        }
      }
    },
