    "MessageLocalFolderDescription" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "\"وحدة تخزين التطبيق الداخلية\" لا يمكن الوصول إليها إلا بواسطة هذا التطبيق. هذا التطبيق يدعم فقط الوسائط التي تم تنزيلها مباشرةً من خلال التطبيق. يمكن استخدام مجلدات التخزين المشتركة للسماح لتطبيقات أخرى بالوصول إلى الوسائط التي تم تنزيلها بواسطة هذا التطبيق."
          }
        },
        "be" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "\"Унутраная памяць праграмы\" даступная толькі для гэтай праграмы. Гэта праграма працуе толькі з медыя, якія былі спампаваныя непасрэдна праз яго. Каб іншыя праграмы маглі атрымаць доступ да медыя, спампаванага гэтай праграмай, можна выкарыстоўваць абагуленыя папкі."
          }
        },
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "'Вътрешното хранилище на приложението' е достъпно само през това приложение. Това приложение поддържа само медийни файлове, изтеглени директно през него. Споделените папки за съхранение могат да се използват, за да се позволи на други приложения да имат достъп до медийните файлове, изтеглени чрез това приложение."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "‘Internal App Storage’ শুধু এই অ্যাপ থেকেই অ্যাক্সেস করা যায়। এই অ্যাপটি শুধুমাত্র অ্যাপের মাধ্যমে সরাসরি ডাউনলোড করা মিডিয়া সমর্থন করে। শেয়ার্ড স্টোরেজ ফোল্ডার ব্যবহার করলে এই অ্যাপের মাধ্যমে ডাউনলোড করা মিডিয়া অন্য অ্যাপ থেকেও অ্যাক্সেস করা যাবে।"
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "'Internal App Storage' is only accessible by this app. This app only supports media downloaded directly through the app. Shared storage folders can be used to allow other apps to access media downloaded by this app."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "„Interní úložiště aplikace“ je přístupné pouze této aplikaci. Tato aplikace podporuje pouze média stažená přímo prostřednictvím aplikace. Složky sdíleného úložiště lze použít k tomu, aby ostatní aplikace měly přístup k médiím staženým touto aplikací."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "'Internt App lager' er kun tilgængelig for denne app. Appen har kun support for medie hentet direkte gennem appen. Delte mapper kan anvendes af andre apps for at få adgang til medie hentet igennem denne app."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Der \"Interne App-Speicher\" ist nur für diese App zugänglich. Diese App unterstützt nur Medien, die direkt über die App heruntergeladen werden. Gemeinsame Speicherordner können verwendet werden, um anderen Apps den Zugriff auf die von dieser App heruntergeladenen Medien zu ermöglichen."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "'Internal App Storage' is only accessible by this app. This app only supports media downloaded directly through the app. Shared storage folders can be used to allow other apps to access media downloaded by this app."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "'Internal App Storage' is only accessible by this app. This app only supports media downloaded directly through the app. Shared storage folders can be used to allow other apps to access media downloaded by this app."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Solo se puede acceder al «Almacenamiento interno de la aplicación» a través de esta aplicación. Esta aplicación solo admite multimedia descargada directamente a través de ella. Las carpetas de almacenamiento compartido se pueden utilizar para permitir que otras aplicaciones accedan a los archivos descargados por esta aplicación."
          }
        },
        "et" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "'Internal App Storage' is only accessible by this app. This app only supports media downloaded directly through the app. Shared storage folders can be used to allow other apps to access media downloaded by this app."
          }
        },
        "fa" : {
