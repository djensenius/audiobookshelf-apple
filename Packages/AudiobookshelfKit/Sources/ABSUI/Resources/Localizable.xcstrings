    "LabelAndroidAutoBrowseLimitForGroupingHelp" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "لا تستخدم السحب الأبجدي عندما يكون عدد العناصر المراد عرضها أقل من هذا العدد"
          }
        },
        "be" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Не выкарыстоўваць алфавітны выпадальны спіс, калі элементаў для паказу менш за гэтую колькасць"
          }
        },
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Не използвай азбучен лимит на показване, когато има по-малко от това количество елементи"
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "প্রদর্শনের জন্য আইটেমের সংখ্যা এর চেয়ে কম হলে বর্ণানুক্রমিক তালিকা ব্যবহার করবেন না"
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No utilitzeu el desplegament alfabètic quan hi hagi menys d'aquest nombre d'elements a mostrar"
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nepoužívejte abecední řazení, pokud je k zobrazení méně než tento počet položek"
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Brug ikke alfabetisk rullemenu når der er færre end dette antal elementer at vise"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Verwenden Sie keine alphabetische Auflistung, wenn weniger als diese Anzahl von Artikeln angezeigt werden soll"
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Μην χρησιμοποιείτε την αλφαβητική λίστα περιορισμού όταν υπάρχουν λιγότερα από αυτά τα στοιχεία για εμφάνιση"
          }
