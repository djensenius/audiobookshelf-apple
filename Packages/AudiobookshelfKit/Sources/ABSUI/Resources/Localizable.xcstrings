    "MessageOldServerAuthReLoginRequired" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تم تحسين المصادقة في الخادم v2.26.0 لضمان الأمان. يُطلب من جميع المستخدمين إعادة تسجيل الدخول."
          }
        },
        "be" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Аўтэнтыфікацыя была палепшана для бяспекі ў серверы v2.26.0. Усім карыстальнікам патрабуецца паўторна ўвайсці ў сістэму."
          }
        },
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "За осигуряването на по-добра сигурност, автентикация беше подобрена във v.2.26.0. Всеки потребител ще трябва да се автентикира наново."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "নিরাপত্তার জন্য সার্ভার v2.26.0-এ অথেনটিকেশন ব্যবস্থা উন্নত করা হয়েছে। সকল ব্যবহারকারীকে আবার লগইন করতে হবে।"
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Authentication has been improved for security in server v2.26.0. All users are required to re-login."
