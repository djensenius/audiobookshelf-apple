    "LabelAutoSleepTimerAutoRewindHelp" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "عندما ينتهي مؤقت النوم التلقائي، فإن تشغيل العنصر مرة أخرى سيؤدي إلى الإرجاع التلقائي."
          }
        },
        "be" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Пасля заканчэння аўтаматычнага таймера сну паўторнае прайграванне элемента аўтаматычна перамотвае вашу пазіцыю."
          }
        },
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Когато автоматичният таймер на изключване изтече, повторното пускане на елемента автоматично ще върне позицията ви назад."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "অটো স্লিপ টাইমার শেষে আইটেমটি আবার চালানো হলে স্বয়ংক্রিয়ভাবে আপনার অবস্থান রিওয়াইন্ড করবে।"
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Quan el temporitzador d'auto sleep acaba, reproduir l'element altra vegada farà que es rebobine automàticament a la teua posició."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Když dojde k uspání automatickým časovačem spánku, pozice přehrávání je posunuta zpět o vybraný čas."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Når den automatiske søvnfunktion er færdig, vil genafspilning af elementet automatisk spole din position tilbage."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wenn die Schlummerfunktion abgelaufen ist, wird bei der erneuten Wiedergabe des Titels die Position automatisch zurückgespult."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Όταν ολοκληρωθεί ο αυτόματος χρονοδιακόπτης ύπνου, η επαναφορά της αναπαραγωγής θα γυρίζει αυτόματα τη θέση σας πίσω."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "When the auto sleep timer finishes, playing the item again will automatically rewind your position."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cuando el cronómetro de auto‐apagado finaliza, reproducir el elemento nuevamente auto‐rebobinará tu posición."
          }
        },
        "et" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "When the auto sleep timer finishes, playing the item again will automatically rewind your position."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "When the auto sleep timer finishes, playing the item again will automatically rewind your position."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kun automaattinen uniajastin päättyy, ensi kerralla toistetaan osa kuunenltua uudelleen."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lorsque le minuteur nocturne se termine, relire l'élément fera un saut en arrière."
          }
        },
        "gu" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "When the auto sleep timer finishes, playing the item again will automatically rewind your position."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "כאשר טיימר השינה האוטומטי מסתיים, הפעלה נוספת של הפריט תגרום אוטומטית להריץ את מיקומך אחורה."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "When the auto sleep timer finishes, playing the item again will automatically rewind your position."
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kada automatsk timer za spavanje završi, ponovna reprodukcija stavke će se automatski vratiti na zadani položaj."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Amikor az automatikus alvásidőzítő befejeződik, az elem újrajátszásakor automatikusan visszatekeri a pozíciót."
          }
        },
        "is" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "When the auto sleep timer finishes, playing the item again will automatically rewind your position."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Al termine del timer di spegnimento automatico, la riproduzione dell'elemento riavvolgerà automaticamente la tua posizione."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "自動スリープタイマーが終了した後、再生を再開すると再生位置が自動的に巻き戻されます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "자동 슬립 타이머가 끝나면 해당 항목을 다시 재생하면 자동으로 위치가 되돌려집니다."
          }
        },
        "lt" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "When the auto sleep timer finishes, playing the item again will automatically rewind your position."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Når automatisk søvntidsur fullføres og du gjenopptar avspillingen vil posisjonen din automatisk spoles tilbake."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wanneer de automatische slaap timer afloop zal het item terugspoelen naar de vorige positie."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Po zakończeniu automatycznego wyłącznika czasowego ponowne odtworzenie elementu spowoduje automatyczne przewinięcie pozycji do tyłu."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Após o timer terminar, da próxima vez que o item for reproduzido a sua posição será retrocedida automaticamente."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Când timerul de somn se termină, la reluarea redării vei fi mutat automat puțin înapoi."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Когда таймер сна закончится, то позиция воспроизведения будет отмотана назад."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Keď Auto časovač spánku skončí, pred nasledujúcim prehratím položky sa prehrávanie automaticky posunie."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ko se samodejni časovnik za spanje konča, bo ponovno predvajanje elementa samodejno previlo na zadnji položaj."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "När den automatiska insomningstimern löper ut spolas uppspelningspositionen automatiskt tillbaka."
          }
        },
        "ta" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ஆட்டோ ச்லீப் நேரங்குறிகருவி முடிந்ததும், உருப்படியை மீண்டும் இயக்குவது தானாகவே உங்கள் நிலையை ரிவைண்ட் செய்யும்."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Otomatik uyku zamanlayıcısı bittiğinde, öğeyi tekrar oynatmak konumunuzu otomatik olarak geri saracaktır."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Коли сплине автотаймер вимкнення, відтворення знову автоматично перемотає доріжку."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Khi bộ đếm thời gian ngủ tự động hoàn thành, việc phát lại mục sẽ tự động lùi lại vị trí của bạn."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "当自动睡眠计时器结束时，再次播放该项目将自动倒带你之前的位置。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "當自動睡眠定時器結束時，再次播放該項目將自動回到當前的位置。"
          }
        }
      }
