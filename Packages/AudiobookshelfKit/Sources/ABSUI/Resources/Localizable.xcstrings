    "MessageItemMissing" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "العنصر مفقود ويجب إصلاحه على الخادم. عادةً ما يتم وضع علامة \"مفقود\" على العنصر لأن مسارات الملفات غير قابلة للوصول."
          }
        },
        "be" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Элемент адсутнічае і патрабуе выпраўлення на серверы. Звычайна элемент пазначаецца як адсутны, таму што файлавыя шляхі недаступныя."
          }
        },
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Елементът липсва и трябва да бъде поправен на сървъра. Обикновено един елемент се маркира като липсващ, защото пътищата към файловете не са достъпни."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "আইটেমটি খুঁজে পাওয়া যাচ্ছে না এবং এটি সার্ভারে ঠিক করতে হবে। সাধারণত ফাইলের পাথ অ্যাক্সেস করা না গেলে কোনো আইটেমকে অনুপস্থিত হিসেবে চিহ্নিত করা হয়।"
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Item is missing and must be fixed on the server. Typically an item is marked as missing because the file paths are not accessible."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Položka chybí a musí být opravena na serveru. Typicky je položka označena jako chybějící, protože cesty k souborům nejsou přístupné."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Genstand mangler og skal rettes på serveren. En genstand markeres typisk som manglende hvis filstier ikke er tilgængelige."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Datei fehlt und muss auf dem Server korrigiert werden. Typischerweise wird eine Datei als fehlend markiert, weil die Dateipfade nicht zugänglich sind."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Item is missing and must be fixed on the server. Typically an item is marked as missing because the file paths are not accessible."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Item is missing and must be fixed on the server. Typically an item is marked as missing because the file paths are not accessible."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Falta un elemento y debe corregirse en el servidor. Normalmente, un elemento se marca como faltante porque no se puede acceder a las rutas de los archivos."
          }
        },
        "et" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Item is missing and must be fixed on the server. Typically an item is marked as missing because the file paths are not accessible."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "new",
